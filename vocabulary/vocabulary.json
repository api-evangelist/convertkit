  "concepts": {
    "subscriber": "A person who has opted in to receive emails from a creator. The core entity in Kit.",
    "tag": "A label applied to subscribers for segmentation and targeting.",
    "sequence": "An automated series of timed emails sent to subscribers.",
    "broadcast": "A one-time email sent to a set of subscribers.",
    "form": "A signup form used to collect subscriber information.",
    "custom_field": "User-defined metadata field attached to subscribers.",
    "snippet": "Reusable content block for email composition.",
    "segment": "A saved filter of subscribers based on shared attributes.",
    "webhook": "An HTTP callback triggered by events in the Kit platform.",
    "purchase": "A purchase event linked to a subscriber for commerce tracking."
