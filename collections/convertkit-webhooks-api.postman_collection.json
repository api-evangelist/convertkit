              "raw": "{\n  \"target_url\": \"<string>\",\n  \"event\": {\n    \"name\": \"<string>\",\n    \"form_id\": {},\n    \"tag_id\": {},\n    \"sequence_id\": {},\n    \"product_id\": {},\n    \"initiator_value\": {},\n    \"custom_field_id\": {}\n  }\n}",
