          "name": "List webhooks",
          "request": {
            "name": "List webhooks",
            "description": {
              "content": "Webhooks are automations that will receive subscriber data when a subscriber event is triggered, such as when a subscriber completes a sequence.<br/><br/>When a webhook is triggered, a `POST` request will be made to your URL with a JSON payload.",
              "type": "text/plain"
            },
